# Template for the public site's production env.
# Copy this to `.env.production` and fill in real values before
# `npm run build` runs against production. Vite reads
# `.env.production` only when `MODE === 'production'`.

VITE_API_ORIGIN=https://api.<your-root-domain>
VITE_PUBLIC_SITE_URL=https://<your-root-domain>

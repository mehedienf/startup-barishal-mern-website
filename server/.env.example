# =========================================================================
# Startup Barishal — Server Environment Variables
# =========================================================================
# Copy this file to `server/.env` and fill in your values for local dev or
# production. Anything missing falls back to a safe development default.
#
#   cp server/.env.example server/.env
#
# IMPORTANT: `SESSION_SECRET` MUST be set to a strong random value in
# production. The default in `config/env.js` is a development-only string
# and any session cookies signed with it should be considered
# forge-able by anyone with the same source code.
# =========================================================================


# --- HTTP -----------------------------------------------------------------
# Port the Express server binds to.
PORT=3000


# --- CORS allowlist -------------------------------------------------------
# Comma-separated list of origins that may call the API via fetch with
# `credentials: include` (admin app uses cookies).
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Extra production / staging origins. Comma-separated, no spaces.
# Example:
#   EXTRA_ORIGINS=https://startupbarishal.olivosoft.com,https://admin.startupbarishal.olivosoft.com
EXTRA_ORIGINS=


# --- Sub-domain hosting topology -----------------------------------------
# Set to `true` when public site, admin, and API live on three separate
# sub-domains (e.g. https://startupbarishal.olivosoft.com/ for the public
# site, https://admin.startupbarishal.olivosoft.com/ for the admin panel,
# https://api.startupbarishal.olivosoft.com/api/* for the backend).
#
# When `true` the server:
#   * serves `dist/client/index.html` only to requests whose `Host`
#     matches `CLIENT_PUBLIC_HOST`,
#   * serves `dist/admin/index.html` only to requests whose `Host`
#     matches `ADMIN_PUBLIC_HOST`,
#   * sets the session cookie with `Domain=.parent.example` +
#     `SameSite=None; Secure` so the browser sends it across sub-domains.
#
# Leave `false` (the default) for the legacy single-host setup where the
# admin lives under `/admin` on the same origin as everything else.
SUBDOMAIN_MODE=false

# Bare hostnames (NO protocol, no path). Required when SUBDOMAIN_MODE=true.
CLIENT_PUBLIC_HOST=
ADMIN_PUBLIC_HOST=
API_PUBLIC_HOST=

# Origin the admin's "Public Site" button should link to. Falls back to
# the dev server (http://localhost:5173) when unset.
PUBLIC_SITE_URL=http://localhost:5173


# --- Session / auth -------------------------------------------------------
# Long random string. Used to HMAC-sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-string

# Cookie name and TTL. Defaults are fine for most deploys; only override
# if you're running multiple apps on the same domain.
SESSION_COOKIE=sb_admin_session
# 7 days in milliseconds
SESSION_TTL_MS=604800000

# Cookie attributes — only relevant when the admin and API live on
# different sub-domains (`SUBDOMAIN_MODE=true`). The defaults match the
# legacy single-origin setup and are safe to keep even in sub-domain
# mode (the server force-toggles `Secure=true` whenever `SameSite=None`).
#
# SESSION_COOKIE_DOMAIN must be the parent domain with a leading dot,
# e.g. `.olivosoft.com`. Empty (default) means host-only — the cookie
# is only sent back to whichever host originally set it.
SESSION_COOKIE_DOMAIN=

# SameSite: one of `strict`, `lax`, or `none`. `none` lets the cookie
# ride along with cross-site POSTs (admin on one subdomain → API on
# another) but REQUIRES `Secure=true`.
SESSION_COOKIE_SAMESITE=lax

# Cookie Secure flag. Empty means "let the server decide" (true when
# SameSite=None, otherwise auto-detect from req.secure).
SESSION_COOKIE_SECURE=


# --- Default admin (used only on first boot) ------------------------------
# On first run the server seeds one admin user from these values. Both
# fields are required; pick a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=startupbarishal


# --- Static SPA mount -----------------------------------------------------
# Where the Vite output lives. The build pipeline (`npm run build`) drops
# `client/dist` + `admin/dist` into the repo root `dist/` after merging.
# Override only if you change the build output layout.
DIST_DIR=../dist

# Where uploaded files (cohort covers, partner logos, etc.) live. The
# server creates per-resource subdirectories on boot if missing.
SERVER_UPLOADS_DIR=./uploads